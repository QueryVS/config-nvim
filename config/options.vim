" Editor defaults.

set number
set relativenumber
set cursorline
set signcolumn=yes
set colorcolumn=100
set scrolloff=8
set sidescrolloff=8
set splitbelow
set splitright
set hidden
set updatetime=300
set timeoutlen=1200
set mouse=a
set clipboard=unnamedplus
set undofile
set ignorecase
set smartcase
set incsearch
set hlsearch
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set smartindent
set completeopt=menuone,noinsert,noselect
set shortmess+=c
set conceallevel=2
set concealcursor=nc
set list
set listchars=tab:»\ ,trail:·,extends:>,precedes:<,nbsp:+
set showtabline=2
set tabline=%!QueryVSTabLine()

filetype plugin indent on
syntax enable
